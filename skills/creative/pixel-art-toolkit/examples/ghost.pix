# ghost - hand-authored example. 16x16, two frames, mirror: x means every row
# below holds only the LEFT 8 cells; the right half is generated by reflection.
# Frame 2 drops the dome one row and swaps the skirt teeth -> a bobbing hover.
name: ghost
size: 16x16
scale: 10
mirror: x

palette:
o = #2a1e4f        # outline: darkest body hue, not black
b = #a78bfa        # body
d = #7c5ce0        # body shadow (same hue, darker + a touch bluer)
w = #ffffff        # eye white
k = #231a44        # pupil
p = #f0a5d8        # cheek blush

pixels:
.,.,.,.,.,.,.,.
.,.,.,.,o,o,o,o
.,.,o,o,b,b,b,b
.,o,o,b,b,b,b,b
.,o,b,b,b,b,b,b
.,o,b,b,b,b,b,b
.,o,b,b,w,w,w,b
.,o,b,b,w,k,k,b
.,o,b,b,w,k,k,b
.,o,b,b,b,b,b,b
.,o,b,p,p,b,b,b
.,o,b,b,b,b,b,b
.,o,d,b,b,b,b,b
.,o,d,d,b,b,b,b
.,o,d,d,o,o,o,d
.,.,o,o,.,.,.,o
---
.,.,.,.,.,.,.,.
.,.,.,.,.,.,.,.
.,.,.,.,o,o,o,o
.,.,o,o,b,b,b,b
.,o,o,b,b,b,b,b
.,o,b,b,b,b,b,b
.,o,b,b,w,w,w,b
.,o,b,b,w,k,k,b
.,o,b,b,w,k,k,b
.,o,b,b,b,b,b,b
.,o,b,p,p,b,b,b
.,o,b,b,b,b,b,b
.,o,d,b,b,b,b,b
.,o,d,d,b,b,b,b
.,o,o,o,d,d,o,o
.,.,.,.,o,o,.,.
